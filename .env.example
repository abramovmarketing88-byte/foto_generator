# Telegram bot token
TELEGRAM_BOT_TOKEN=insert_telegram_bot_token

# Gemini (analysis only)
GEMINI_API_KEY=insert_gemini_api_key
GEMINI_ANALYSIS_MODEL=gemini-2.0-flash
GEMINI_RETRIES=3

# NanoBanana (image generation only)
NANOBANANA_API_KEY=insert_nanobanana_api_key
NANOBANANA_BASE_URL=https://api.nanobanana.example
NANOBANANA_GENERATE_PATH=/v1/generate
NANOBANANA_TIMEOUT_SEC=60
NANOBANANA_RETRIES=5

# Worker
JOB_TIMEOUT_SEC=120

# Storage and database
DATABASE_URL=sqlite+pysqlite:///./storage/neurophotoshoot.db
STORAGE_DIR=./storage

# Limits
MAX_PHOTOS_PER_USER=20
MAX_CONCURRENT_JOBS_PER_USER=2
